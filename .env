# ─────────────────────────────────────────────────────────────────────────────
# .env  —  Environment configuration for Playwright Framework
# NEVER commit real credentials.  Copy this file to .env.local and override.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application URLs ──────────────────────────────────────────────────────────
BASE_URL=https://the-internet.herokuapp.com
API_BASE_URL=https://reqres.in/api

# ── Credentials ───────────────────────────────────────────────────────────────
VALID_USERNAME=tomsmith
VALID_PASSWORD=SuperSecretPassword!
INVALID_USERNAME=wronguser
INVALID_PASSWORD=wrongpass
API_KEY=free_user_3ETruhjxnJGCpjgvU2rYJ81oGmQ

# ── Browser / Execution ──────────────────────────────────────────────────────
HEADLESS=true
BROWSER=chromium           # chromium | firefox | webkit
WORKERS=4                  # parallel worker count

# ── Timeouts (ms) ─────────────────────────────────────────────────────────────
TEST_TIMEOUT=60000
EXPECT_TIMEOUT=10000
NAVIGATION_TIMEOUT=30000
ACTION_TIMEOUT=15000

# ── Retry ─────────────────────────────────────────────────────────────────────
RETRIES=0                  # overridden to 2 on CI automatically

# ── Reporting ─────────────────────────────────────────────────────────────────
REPORT_DIR=reports
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=true
TRACE_ON_FAILURE=true

# ── Misc ──────────────────────────────────────────────────────────────────────
IGNORE_HTTPS_ERRORS=false
LOG_LEVEL=info             # error | warn | info | debug
