{
  "name": "playwright-automation-framework",
  "version": "1.0.0",
  "description": "Production-ready Playwright automation framework using JavaScript with POM design pattern",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:login": "playwright test tests/e2e/login.spec.js",
    "test:forms": "playwright test tests/e2e/forms.spec.js",
    "test:api": "playwright test tests/api/",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:parallel": "playwright test --workers=4",
    "test:serial": "playwright test --workers=1",
    "test:report": "playwright show-report reports/html",
    "test:codegen": "playwright codegen",
    "test:trace": "playwright show-trace",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix"
  },
  "dependencies": {
    "@faker-js/faker": "^8.4.1",
    "allure-playwright": "^3.0.0-beta.6",
    "axios": "^1.16.1",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.6.1",
    "faker": "^6.6.6",
    "googleapis": "^173.0.0",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "nodemailer": "^8.0.10",
    "qs": "^6.15.2",
    "winston": "^3.13.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.3.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.0",
    "@types/qs": "^6.15.1",
    "eslint": "^9.3.0",
    "eslint-plugin-playwright": "^1.6.2"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing",
    "e2e",
    "pom",
    "javascript"
  ],
  "author": "QA Automation Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhumit5207/playwright-framework.git"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/bhumit5207/playwright-framework/issues"
  },
  "homepage": "https://github.com/bhumit5207/playwright-framework#readme"
}
